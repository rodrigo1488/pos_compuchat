<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Voltar"
            android:src="@drawable/ic_voltar" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Pedidos do dia"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <include layout="@layout/include_offline_banner" />

    <CheckBox
        android:id="@+id/chkAgruparMesa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Agrupar por mesa" />

    <RadioGroup
        android:id="@+id/filterPedidos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/filterPendentes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Pendentes" />

        <RadioButton
            android:id="@+id/filterTodosPedidos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Todos" />
    </RadioGroup>

    <TextView
        android:id="@+id/txtPedidosEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:text="Nenhum pedido pendente"
        android:textColor="#6B7280"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listPedidos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
